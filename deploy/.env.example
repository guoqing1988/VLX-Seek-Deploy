# VLX-Seek 常驻服务环境变量模板
# 用法：cp deploy/.env.example deploy/.env && sudo systemctl restart vlx-seek
# 格式：systemd EnvironmentFile（KEY=value，不要写 export，不要加引号）

HOST=0.0.0.0
PORT=8110
INSTANCES=2
IDLE_UNLOAD_S=300
PRECISION=q8_0
DEVICE=cuda

# 多卡时指定物理 GPU 索引（nvidia-smi 里的编号）；留空 = 用第 0 张/全部可见卡
# 多卡并行建议起多个服务实例，每个绑不同 GPU、不同 PORT
GPU=
IMAGE_PROXY=
EXTRA_ARGS=--preload
