# VLX-Seek 常驻服务环境变量
# 格式：systemd EnvironmentFile（KEY=value，不要写 export，不要加引号）
# 由 deploy/vlx-seek.service 通过 EnvironmentFile 注入，再传给 deploy/server/serve.sh
#
# 修改后执行：sudo systemctl restart vlx-seek

# 监听地址：0.0.0.0 = 所有网卡（注意防火墙/安全组，默认不再只绑本机）
HOST=0.0.0.0
PORT=8110

# 并发实例数：每个实例独立 ctx（q8_0 下单实例约 9–14 GiB，取决于图像分辨率）
INSTANCES=2

# 空闲多少秒卸载模型（0 = 永不卸载）；卸载后下一次请求自动重新加载
IDLE_UNLOAD_S=300

# 视觉/LLM 精度：q8_0（省显存）或 f16
PRECISION=q8_0
DEVICE=cuda

# 多卡时指定物理 GPU 索引（nvidia-smi 里的编号）；留空 = 用第 0 张/全部可见卡
# 多卡并行建议起多个服务实例，每个绑不同 GPU、不同 PORT
GPU=

# 图像 URL 下载代理，例如 http://127.0.0.1:7890；留空则读进程环境的 https_proxy/http_proxy
IMAGE_PROXY=

# API key：留空 = 不启用认证；启用后客户端需带 Authorization: Bearer <key>
# 或多个 key 用逗号分隔（轮换）：API_KEY=key1,key2
API_KEY=

# 追加给 vlx-seek-server 的参数（空格分隔）
# 常用：--preload（启动即加载+预热，首请求也低延迟）、--max-image-tokens 2000（保小目标）
EXTRA_ARGS=--preload
